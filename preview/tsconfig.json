{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@apexrn/ui": ["../packages/ui/index.ts"],
      "@/components/apexrn": ["../packages/ui/components/index.ts"],
      "@/lib/apexrn/*": ["../packages/ui/lib/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../packages/ui/**/*.ts", "../packages/ui/**/*.tsx"],
  "exclude": ["node_modules", "dist", "../packages/ui/node_modules"]
}
