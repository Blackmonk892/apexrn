{
  "expo": {
    "name": "demo",
    "slug": "demo",
    "scheme": "apexrn-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.apexrn.demo",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "tsconfigPaths": false,
      "baseUrl": "/lab"
    }
  }
}
